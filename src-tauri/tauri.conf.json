{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Sync",
  "version": "1.1.1",
  "identifier": "com.skillsync.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skill Sync",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MTg0RjhDNzc0NjBCQzEKUldUQkMwWjNqRThZNVIvS1NSZE5lSVlSZlRhNmxNc3dmZkQzVVl1QTlJSExQeWVoWnZDYzF3MG8K",
      "endpoints": [
        "https://github.com/TreatTrick/skill-sync/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
