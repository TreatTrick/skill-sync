{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Skill Sync main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "log:default",
    "os:allow-platform",
    "os:allow-arch",
    "process:allow-restart",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
